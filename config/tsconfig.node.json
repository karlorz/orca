{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "../electron.vite.config.*",
    "./build-plugins/**/*",
    "./scripts/vitest-host-ports-setup.ts",
    "../src/main/**/*",
    "../src/renderer/src/lib/skill-freshness-display-status.ts",
    "../src/preload/**/*",
    "../src/shared/**/*",
    "../src/relay/**/*",
    "../src/types/**/*"
  ],
  // This one test pins the shipped cloud verifier (cloud/apps/relay) whose
  // zod v3 + relay-contract dist type graph is not part of the root typecheck.
  "exclude": ["../src/main/runtime/relay/own-mobile-relay-jwt-issuer.test.ts"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
