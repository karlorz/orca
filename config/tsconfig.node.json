{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "../electron.vite.config.*",
    "./vitest.config.ts",
    "./build-plugins/**/*",
    "./scripts/vitest-host-ports-setup.ts",
    "./scripts/vitest-caller-identity-env-setup.ts",
    "./scripts/vitest-real-agent-home-write-guard.ts",
    "./scripts/vitest-bun-node-builtins.ts",
    "./scripts/vitest-dom-setup.ts",
    "./scripts/happy-dom-offscreen-canvas.ts",
    "./scripts/happy-dom-mutation-observer-retention.ts",
    "./scripts/happy-dom-animation-cancel.ts",
    "./scripts/vitest-node-runtime-pool.ts",
    "./scripts/orca-home-appimage-install.ts",
    "./scripts/orca-home-appimage-verification.ts",
    "../src/main/**/*",
    "../src/renderer/src/store/slices/worktrees/create/worktree-create-payload.ts",
    "../src/renderer/src/components/native-chat/native-chat-resolution-receipt.ts",
    "../src/renderer/src/components/native-chat/structured-agent-question-projection.ts",
    "../src/renderer/src/components/native-chat/native-chat-subagent-delegation.ts",
    "../src/renderer/src/components/native-chat/structured-agent-session-queued-cards.ts",
    "../src/renderer/src/components/native-chat/structured-agent-session-pending-sends.ts",
    "../src/renderer/src/components/native-chat/native-chat-composer-primary-action.ts",
    "../src/renderer/src/components/terminal-pane/legacy-relay-bridge-panes.ts",
    "../src/preload/**/*",
    "../src/shared/**/*",
    "../src/packages/process-host/src/__fixtures__/**/*",
    "../src/wsl-guest/**/*",
    "../src/types/**/*"
  ],
  // This one test pins the shipped cloud verifier (cloud/apps/relay) whose
  // zod v3 + relay-contract dist type graph is not part of the root typecheck.
  "exclude": [
    "../src/main/runtime/mobile-cloud-relay/own-mobile-relay-jwt-issuer.test.ts",
    "../src/main/runtime/mobile-cloud-relay/own-mobile-relay-jwt-grant-isolation.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["electron-vite/node"]
  }
}
